#!/bin/bash

# Enable and start services
if command -v systemctl &>/dev/null && systemctl --user --version &>/dev/null; then
  echo "Enabling and starting services..."
  # /usr/lib/systemd/system-generators/podman-system-generator --user ~/.config/systemd/user/
  systemctl --user daemon-reload
  systemctl --user enable rclone-zettelkasten.service
  systemctl --user start rclone-zettelkasten.service
  systemctl --user enable hypr-dock-watch.service
  systemctl --user start hypr-dock-watch.service
  # llama-server + mcp-servers: manual only (GPU-heavy)
  # Start with: systemctl --user start llama-server
  # (mcp-servers starts/stops automatically with llama-server)
fi

# Install the font
if [ ! -f ~/.local/share/fonts/HackNerdFont-Regular.ttf ]; then
  echo "Install HackNerdFont"
  wget -P /tmp/ https://github.com/ryanoasis/nerd-fonts/releases/download/v3.4.0/Hack.zip
  unzip /tmp/Hack.zip -d ~/.local/share/fonts/
  fc-cache -vf ~/.local/share/fonts
fi

# Claude Code: settings.json, CLAUDE.md and RTK.md are yadm-tracked under
# ~/.claude, ~/.serena/serena_config.yml likewise. What can't be tracked —
# binaries, plugin installs and the MCP registration (stored in ~/.claude.json
# alongside OAuth state) — is set up here. Every step is a no-op on re-run.
if command -v claude &>/dev/null; then
  echo "Setting up Claude Code tooling..."
  if command -v brew &>/dev/null && ! command -v rtk &>/dev/null; then
    brew install rtk
  fi
  if command -v uv &>/dev/null && ! command -v serena &>/dev/null; then
    uv tool install -p 3.13 serena-agent
  fi
  if ! claude plugin marketplace list 2>/dev/null | grep -q "claude-plugins-official"; then
    claude plugin marketplace add anthropics/claude-plugins-official
  fi
  # Only Rust gets a native LSP plugin (for post-edit diagnostics); Serena
  # covers code navigation for every language.
  if ! claude plugin list 2>/dev/null | grep -q "rust-analyzer-lsp@claude-plugins-official"; then
    claude plugin install rust-analyzer-lsp@claude-plugins-official
  fi
  if command -v serena &>/dev/null && ! claude mcp get serena &>/dev/null; then
    claude mcp add-json --scope user serena \
      '{"type":"stdio","command":"serena","args":["start-mcp-server","--context","claude-code","--project-from-cwd"]}'
  fi
fi

# Install neovim config
if [ ! -f ~/.config/nvim/init.lua ]; then
  echo "Installing NeoVim config"
  git clone https://github.com/Rom3dius/lazyvim-romedius ~/.config/nvim
fi

# Vendor caelestia-dots' desktop-shell components (caelestia's own CLI/manifest
# system is Arch/AUR-only, so this replicates its documented manual-install
# mapping: https://github.com/caelestia-dots/caelestia/blob/main/manifest.toml).
# Only components we don't already track ourselves in this repo, and actually
# want, are copied — NOT fastfetch (own config), NOT fish/foot (kept zsh +
# kitty instead), NOT thunar (kept GNOME's Nautilus instead), NOT
# starship.toml (own Wintergreen-themed prompt). This overwrites the
# destination every run, so customize via ~/.config/caelestia/hypr-vars.lua
# and ~/.config/caelestia/hypr-user.lua instead of editing vendored files.
CAELESTIA_CACHE="$HOME/.cache/caelestia-dots"
echo "Syncing caelestia-dots components..."
if [ -d "$CAELESTIA_CACHE/.git" ]; then
  git -C "$CAELESTIA_CACHE" pull --ff-only
else
  rm -rf "$CAELESTIA_CACHE"
  git clone --depth=1 https://github.com/caelestia-dots/caelestia.git "$CAELESTIA_CACHE"
fi

mkdir -p ~/.config
for dir in btop micro; do
  rm -rf "$HOME/.config/${dir}"
  cp -r "$CAELESTIA_CACHE/${dir}" "$HOME/.config/${dir}"
done

# hypr/ needs special handling: scheme/current.lua is a runtime state file
# (the active colour scheme, written by `caelestia scheme set`) and
# monitors.lua is machine-specific state (written by nwg-displays) — neither
# is part of caelestia's static config, so a plain overwrite would revert
# the theme / clobber the monitor layout on every yadm bootstrap re-run.
# rsync --delete syncs everything else while leaving those two alone.
mkdir -p ~/.config/hypr
rsync -a --delete --exclude='scheme/current.lua' --exclude='monitors.lua' "$CAELESTIA_CACHE/hypr/" ~/.config/hypr/

# Seed monitors.lua on first run only — hypr-user.lua does `require("monitors")`,
# which errors out if the file doesn't exist at all (unlike scheme/current.lua,
# caelestia's hyprland.lua has no maybe_copy-style fallback for it).
# monitors.lua.reference is yadm-tracked at the repo root ($HOME).
if [ ! -f ~/.config/hypr/monitors.lua ] && [ -f ~/monitors.lua.reference ]; then
  cp ~/monitors.lua.reference ~/.config/hypr/monitors.lua
fi

mkdir -p ~/.local/state/caelestia

# Initialize caelestia's wallpaper + colour scheme state (normally done by
# caelestia-cli's own manifest post_install hooks, which we bypass by
# vendoring files manually instead of using their installer). Without this,
# first login is a blank, unthemed shell until someone runs these manually.
# Wallpaper is yadm-tracked directly at Pictures/Wallpapers/ (unlike the old
# pine-wallpaper.jpg, this one isn't baked into the hyprome image, so it has
# to live in this repo to be reproducible on a fresh install).
DEFAULT_WALLPAPER="$HOME/Pictures/Wallpapers/axalp-ch-f18.jpg"
if [ ! -f ~/.local/state/caelestia/wallpaper/path.txt ] && command -v caelestia &>/dev/null; then
  echo "Initializing caelestia wallpaper + scheme..."
  if [ -f "$DEFAULT_WALLPAPER" ]; then
    caelestia wallpaper -n -f "$DEFAULT_WALLPAPER"
  fi
  # No "wintergreen" scheme exists in caelestia-cli's built-in set (see
  # THEMING.md) — darkgreen is the closest built-in match.
  caelestia scheme set -n darkgreen
fi
